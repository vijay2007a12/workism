rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && userRole() == 'admin';
    }

    function isEmployer() {
      return signedIn() && userRole() == 'employer';
    }

    function hasOnlyAllowedKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && hasOnlyAllowedKeys([
          'uid',
          'name',
          'email',
          'role',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['candidate', 'employer', 'admin']
        && request.resource.data.status == 'active';
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();
    }

    match /simulations/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin() || isEmployer();
      allow create: if signedIn()
        && hasOnlyAllowedKeys([
          'role',
          'title',
          'brief',
          'status',
          'progress',
          'userId',
          'userEmail',
          'userRole',
          'source',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.status in ['created', 'started', 'submitted', 'completed']
        && request.resource.data.progress is number
        && request.resource.data.progress >= 0
        && request.resource.data.progress <= 100;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /workRecordEvents/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin() || isEmployer();
      allow create: if signedIn()
        && hasOnlyAllowedKeys([
          'taskId',
          'simulationName',
          'completedDate',
          'result',
          'action',
          'userId',
          'userEmail',
          'userRole',
          'source',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.taskId is string
        && request.resource.data.simulationName is string
        && request.resource.data.action in ['viewed', 'downloaded'];
      allow update, delete: if isAdmin();
    }

    match /analyticsEvents/{docId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && hasOnlyAllowedKeys([
          'action',
          'userId',
          'userEmail',
          'userRole',
          'source',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.action is string;
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
