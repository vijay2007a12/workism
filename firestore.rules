rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingDoc() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsNewDoc() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['candidate', 'employer', 'admin'];
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /simulations/{docId} {
      allow read: if ownsExistingDoc();
      allow create: if ownsNewDoc()
        && request.resource.data.status in ['created', 'started', 'submitted', 'completed']
        && request.resource.data.progress >= 0
        && request.resource.data.progress <= 100;
      allow update: if ownsExistingDoc();
      allow delete: if false;
    }

    match /workRecordEvents/{docId} {
      allow read: if ownsExistingDoc();
      allow create: if ownsNewDoc()
        && request.resource.data.action in ['viewed', 'downloaded'];
      allow update, delete: if false;
    }

    match /analyticsEvents/{docId} {
      allow read: if ownsExistingDoc();
      allow create: if ownsNewDoc()
        && request.resource.data.action is string;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
